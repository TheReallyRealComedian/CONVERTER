# .dockerignore

# Docker-specific files
.dockerignore
Dockerfile
# IMG-CONTEXT: Glob statt docker-compose.yml — nimmt den gitignorten
# Mac-Dev-Override (docker-compose.override.yml) mit.
docker-compose*.yml

# Git and version control
.git
.gitignore
# ARCH-BUILD: vier Zeilen Diff-Konfiguration ohne Laufzeit-Leser — lag nach
# dem Deploy 495bc81391aa im Image (`ls -A /app`), seit dem Wrap draussen.
.gitattributes

# Python virtual environments and cache
# IMG-CONTEXT: `**/` = in jeder Tiefe, die Wurzel eingeschlossen — ohne
# trafen die Muster nur die Wurzel (Docker liest sie wurzel-verankert).
**/__pycache__/
**/*.pyc
*.pyo
*.pyd
venv/
env/

# macOS metadata files (This is very important for you!) — in jeder Tiefe
**/.DS_Store
**/._*

# Generated output files (These are handled by volumes in docker-compose)
output_pdfs/

# Not needed in the image (DOC-ENGINE P2): corpus/ alone is 6.5 GB and made
# the COPY layer 7.08 GB; tests/ and docs/ are verified unreferenced by app
# code and Dockerfile (pytest runs locally, never in the container).
corpus/
tests/
docs/

# IDE / Editor specific configs
.vscode/
.idea/
# DOC-LOCAL: Austausch-Verzeichnis (Host-Bind, Laufzeit-Zustand)
doclocal_exchange/
# SEC-NONROOT: die zwei anderen Mount-Punkte ebenso — das Dockerfile legt alle
# drei als 1000:1000 an, und `COPY . .` setzt ein gleichnamiges Verzeichnis
# aus dem Kontext auf root zurueck (gemessen): ein frisches Volume gehoerte
# dann wieder root, und der Prozess koennte nicht hineinschreiben.
data/
output_podcasts/

# IMG-CONTEXT: `COPY . .` kopiert das Verzeichnis, nicht das Repo — was
# .gitignore vor Git versteckt, liegt trotzdem im Build-Kontext und kaeme ins
# Image. Die Grenze ist diese Datei; die Muss-Liste pinnt
# tests/test_dockerignore.py. keyterms.json bleibt bewusst drin (Deepgram
# liest es zur Laufzeit).
#
# Geheimnisse: der GCP-Schluessel kommt zur Laufzeit per Compose-Bind an Web
# und Worker, die Env per env_file. `.env*` ersetzt `.env` und trifft
# .env.example mit (kein Laufzeit-Leser).
google-credentials.json
.env*

# Werkzeug-Zustand (Claude Code, CodeBuddy, pytest) — kein Laufzeit-Leser.
.claude/
.codebuddy/
.pytest_cache/

# DB-Kopien, falls je wieder welche im Clone liegen (MINTBOX-BAK).
app_data_bak-*

# Master-Docs ohne Laufzeit-Leser (die Container-Suite streamt pytest.ini
# mit dem Arbeitsbaum, s. CLAUDE.md *Key Files*). Die zwei Root-Skripte, die
# hier standen, sind seit ARCH-BUILD geloescht (0 Leser, Mai 2026).
BACKLOG.md
STATUS.md
CLAUDE.md
MASTER_BACKLOG_HANDOFF_*.md
pytest.ini
