# marker v2 (datalab) — GPU-Kandidat P3
# Schlanke Python-Basis statt pytorch/conda-Image: pip loest torch/vision
# konsistent aus marker-pdfs eigenem Baum (die conda-Basis endete in einem
# ABI-Bruch: pip-Upgrade von torch liess libtorchaudio.so nicht mehr laden).
# torch-cu12-Wheels buendeln die CUDA-Runtime; der Host stellt nur den Treiber.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

ARG MARKER_VERSION=">=2.0.0"
RUN pip install --no-cache-dir "marker-pdf${MARKER_VERSION}" \
    && pip uninstall -y torchaudio 2>/dev/null; \
    python -c "import torch, torchvision, marker; print('torch', torch.__version__, 'cuda', torch.version.cuda)"

ENV HF_HOME=/models
WORKDIR /work
